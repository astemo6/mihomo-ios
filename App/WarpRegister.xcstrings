          }
        }
      }
    },
    "节点已删除，但设备未能注销": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The node was deleted, but its device could not be unregistered"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードは削除されましたが、デバイスの登録を解除できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드가 삭제되었지만 기기 등록을 해제하지 못했습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узел удалён, но регистрацию устройства отменить не удалось"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點已刪除，但裝置未能註銷"
          }
        }
      }
    },
    "节点已重新注册，但旧设备未能注销": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The node was re-registered, but the old device could not be unregistered"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードは再登録されましたが、旧デバイスの登録を解除できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드가 재등록되었지만 이전 기기의 등록을 해제하지 못했습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узел перерегистрирован, но регистрацию старого устройства отменить не удалось"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點已重新註冊，但舊裝置未能註銷"
          }
        }
      }
    },
    "这是 Cloudflare 客户端使用的非官方接口，Cloudflare 可能随时调整或限制。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This uses the unofficial API of the Cloudflare client apps; Cloudflare may change or limit it at any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare クライアントが使う非公式 API を利用しています。Cloudflare により予告なく変更・制限される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 클라이언트가 사용하는 비공식 API를 이용합니다. Cloudflare가 언제든지 변경하거나 제한할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется неофициальный API клиентов Cloudflare; Cloudflare может изменить или ограничить его в любой момент."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 Cloudflare 用戶端使用的非官方介面，Cloudflare 可能隨時調整或限制。"
          }
        }
      }
    },
