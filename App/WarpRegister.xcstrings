    "已添加节点「%@」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added node “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノード「%@」を追加しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드 「%@」을(를) 추가했습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узел «%@» добавлен"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增節點「%@」"
          }
        }
      }
    },
    "已重新注册，节点密钥已更新": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-registered — the node's keys have been updated"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再登録しました。ノードの鍵が更新されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재등록되었습니다. 노드 키가 업데이트되었습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перерегистрировано — ключи узла обновлены"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已重新註冊，節點金鑰已更新"
          }
        }
      }
    },
    "我已阅读并同意 Cloudflare WARP 服务条款与隐私政策": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read and agree to the Cloudflare WARP Terms of Service and Privacy Policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP の利用規約とプライバシーポリシーを読み、同意します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 서비스 약관 및 개인정보 처리방침을 읽었으며 이에 동의합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прочитал(а) и принимаю Условия использования и Политику конфиденциальности Cloudflare WARP"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已閱讀並同意 Cloudflare WARP 服務條款與隱私權政策"
          }
        }
      }
    },
    "无法连接 Cloudflare WARP 注册接口：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the Cloudflare WARP registration API: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 登録 API に接続できません：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 등록 API에 연결할 수 없습니다: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет связи с API регистрации Cloudflare WARP: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線 Cloudflare WARP 註冊介面：%@"
          }
        }
      }
    },
    "服务条款": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of Service"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스 약관"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Условия использования"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務條款"
          }
        }
      }
    },
    "注册一个免费的 Cloudflare WARP 设备，并生成 MASQUE 节点。密钥只在本机生成，节点保存在手动节点里。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register a free Cloudflare WARP device and create a MASQUE node. The key is generated on this device only; the node is saved with your manual nodes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の Cloudflare WARP デバイスを登録し、MASQUE ノードを作成します。鍵はこの端末でのみ生成され、ノードは手動ノードに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 Cloudflare WARP 기기를 등록하고 MASQUE 노드를 만듭니다. 키는 이 기기에서만 생성되며 노드는 수동 노드에 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрирует бесплатное устройство Cloudflare WARP и создаёт узел MASQUE. Ключ создаётся только на этом устройстве, узел сохраняется среди ручных узлов."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊一個免費的 Cloudflare WARP 裝置，並產生 MASQUE 節點。金鑰只在本機產生，節點儲存在手動節點裡。"
          }
        }
      }
    },
    "注册并添加节点": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register and Add Node"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録してノードを追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록하고 노드 추가"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрировать и добавить узел"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊並新增節點"
          }
        }
      }
    },
