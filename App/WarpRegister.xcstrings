{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "Cloudflare WARP 注册失败（%@ HTTP %lld）%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP registration failed (%1$@ HTTP %2$lld)%3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP の登録に失敗しました（%1$@ HTTP %2$lld）%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 등록 실패 (%1$@ HTTP %2$lld)%3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зарегистрировать Cloudflare WARP (%1$@ HTTP %2$lld)%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 註冊失敗（%1$@ HTTP %2$lld）%3$@"
          }
        }
      }
    },
    "Cloudflare WARP 注册被限流（HTTP 429），请稍后重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP registration was rate limited (HTTP 429), please try again later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP の登録がレート制限されました（HTTP 429）。しばらくしてから再試行してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 등록이 제한되었습니다 (HTTP 429). 잠시 후 다시 시도하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация Cloudflare WARP ограничена (HTTP 429), повторите попытку позже"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 註冊被限流（HTTP 429），請稍後重試"
          }
        }
      }
    },
    "Cloudflare WARP 注册返回的数据不完整：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incomplete Cloudflare WARP registration response: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 登録の応答が不完全です：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 등록 응답이 불완전합니다: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неполный ответ регистрации Cloudflare WARP: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare WARP 註冊回傳的資料不完整：%@"
          }
        }
      }
    },
    "一键注册 · MASQUE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-tap registration · MASQUE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップ登録 · MASQUE"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원터치 등록 · MASQUE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация в один тап · MASQUE"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵註冊 · MASQUE"
          }
        }
      }
    },
    "取消": {
