        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 서버를 찾지 못했습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-серверы не найдены"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有讀到 DNS 伺服器"
          }
        }
      }
    },
    "系统 DNS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System DNS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム DNS"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 DNS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный DNS"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統 DNS"
          }
        }
      }
    },
    "代理连接时，系统 DNS 指向隧道（由内核接管），这里显示的是隧道的地址，不是路由器下发的 DNS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the proxy is connected, system DNS points into the tunnel (handled by the core), so this shows the tunnel's address, not the DNS your router hands out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシ接続中はシステム DNS がトンネル（コアが処理）を指すため、ここにはルーターが配布した DNS ではなくトンネルのアドレスが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프록시가 연결된 동안 시스템 DNS는 터널(코어가 처리)을 가리키므로, 여기에는 공유기가 준 DNS가 아니라 터널 주소가 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока прокси подключён, системный DNS указывает в туннель (его обрабатывает ядро), поэтому здесь адрес туннеля, а не DNS от роутера."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理連線時，系統 DNS 指向隧道（由核心接管），這裡顯示的是隧道的地址，不是路由器下發的 DNS。"
          }
        }
      }
    },
    "当前网络下发给本机的 DNS 服务器。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DNS servers this network gave the device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のネットワークがこの端末に配布した DNS サーバー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 네트워크가 이 기기에 준 DNS 서버입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-серверы, выданные устройству этой сетью."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前網路下發給本機的 DNS 伺服器。"
          }
        }
      }
    },
    "已复制 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
