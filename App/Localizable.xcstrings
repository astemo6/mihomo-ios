    "%lld 项更新失败，可在对应页面查看": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items failed to update; see their pages for details"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の更新に失敗しました。各ページで確認できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목을 업데이트하지 못했습니다. 각 페이지에서 확인하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить элементов: %lld; подробности на их страницах"
          }
        },
        "zh-Hant": {
