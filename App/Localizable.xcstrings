          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MitM 루트 인증서와 개인 키 포함"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить корневой сертификат MitM и закрытый ключ"
