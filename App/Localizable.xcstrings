    "1 天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 day"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 天"
          }
        }
      }
    },
    "1. 点「安装证书（通过 Safari）」，在弹窗中选择「允许」下载描述文件（或用「分享 / 存储描述文件」存到“文件”后在“文件”App 中点开）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tap “Install Certificate (via Safari)” and choose “Allow” to download the profile (or use “Share / Save Profile” to save it to Files and open it there)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 點「安裝證書（透過 Safari）」，在彈窗中選擇「允許」下載描述檔案（或用「分享 / 儲存描述檔案」存到“檔案”後在“檔案”App 中點開）。"
          }
        }
      }
    },
    "10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10"
          }
        }
      }
    },
    "12 小时": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12 hours"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "12 小時"
          }
        }
      }
    },
    "120 天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "120 days"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "120 天"
          }
        }
      }
    },
    "2. 打开 设置 → 已下载描述文件（或 通用 → VPN 与设备管理）→ 安装，输入锁屏密码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Open Settings → Profile Downloaded (or General → VPN & Device Management) → Install, and enter your passcode."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 開啟 設定 → 已下載描述檔案（或 通用 → VPN 與裝置管理）→ 安裝，輸入鎖屏密碼。"
          }
        }
      }
    },
    "3. 打开 设置 → 通用 → 关于本机 → 证书信任设置，打开「%@」的完全信任。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Open Settings → General → About → Certificate Trust Settings and enable full trust for “%@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 開啟 設定 → 通用 → 關於本機 → 證書信任設定，開啟「%@」的完全信任。"
          }
        }
      }
    },
    "30 天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 days"
          }
        },
        "zh-Hant": {
          "stringUnit": {
