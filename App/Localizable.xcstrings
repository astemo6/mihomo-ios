          "stringUnit": {
            "state": "translated",
            "value": "System follows the iPhone's light / dark appearance. Widgets always follow the system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システムに合わせる」では iPhone のライト / ダーク表示に従います。ウィジェットは常にシステムに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정을 선택하면 iPhone의 라이트 / 다크 모드를 따릅니다. 위젯은 항상 시스템을 따릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Как в системе» следует светлому / тёмному оформлению iPhone. Виджеты всегда следуют системе."
          }
        }
      }
    },
