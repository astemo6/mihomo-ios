          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태, 아웃바운드 모드, 현재 노드와 프로파일을 반환하여 단축어에서 이어서 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает состояние подключения, режим, текущий узел и профиль для следующих шагов команды."
          }
        }
      }
    },
