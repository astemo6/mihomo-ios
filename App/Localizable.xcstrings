          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트가 저장한 데이터(BoxJS 설정, 로그인 정보 등)가 모두 삭제되며 복구할 수 없습니다."
          }
        },
        "ru": {
