    },
    "拒绝所有 QUIC（UDP 443），App 自动改用 TCP，规则与 MitM 对它们都生效。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕所有 QUIC（UDP 443），App 自動改用 TCP，規則與 MitM 對它們都生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejects all QUIC (UDP 443); apps fall back to TCP, where rules and MitM apply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての QUIC（UDP 443）を拒否します。App は TCP に切り替わり、ルールと MitM が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 QUIC(UDP 443)을 거부합니다. 앱은 TCP로 전환되며 규칙과 MitM이 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь QUIC (UDP 443) отклоняется; приложения переходят на TCP, где действуют правила и MitM."
          }
        }
      }
    },
