    "在 规则 → 全局 → 直连 之间切换": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 規則 → 全域 → 直連 之間切換"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle Rule → Global → Direct"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
