    "全不选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select None"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
