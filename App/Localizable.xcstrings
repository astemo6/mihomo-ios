        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張が正常に終了しませんでした（システムによる終了、クラッシュ、またはデバイスの電源オフ）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장이 정상적으로 종료되지 않음(시스템 종료, 충돌 또는 기기 전원 꺼짐)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение завершилось некорректно (остановлено системой, сбой или выключение устройства)"
