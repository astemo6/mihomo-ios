    "已连接时断开，未连接时连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnects when connected, connects when disconnected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線時斷開，未連線時連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中なら切断し、未接続なら接続します。"
