    "等待首次评分（使用策略组自身的健康检查结果）": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待首次評分（使用策略組自身的健康檢查結果）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the first score (uses the group's own health checks)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の評価待ち（グループ自身のヘルスチェック結果を使用）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 점수 대기 중(그룹 자체 상태 확인 결과 사용)"
          }
        },
        "ru": {
