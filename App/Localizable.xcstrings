          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポリシーグループ（空欄 = 最初の手動選択グループ）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정책 그룹(비우면 첫 번째 수동 선택 그룹)"
          }
        },
        "ru": {
          "stringUnit": {
