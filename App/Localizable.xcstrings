            "value": "Validated as you type: shows the converted mihomo rule and its policy group."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入時實時校驗：顯示轉換後的 mihomo 規則和對應的策略組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
