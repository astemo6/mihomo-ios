    "直连 / 代理": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直連 / 代理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct / Proxy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイレクト / プロキシ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
