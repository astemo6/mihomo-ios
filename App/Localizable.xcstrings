    "HTTPS 解密（MitM）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS Decryption (MitM)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 解密（MitM）"
          }
        },
        "ja": {
          "stringUnit": {
