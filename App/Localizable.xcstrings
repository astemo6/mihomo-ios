        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group is not in the profile file (added at runtime), so its position can't be changed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループはプロファイルにない（実行時に追加）ため、位置を変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹은 프로파일에 없어서(런타임에 추가됨) 위치를 바꿀 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой группы нет в файле профиля (добавлена при запуске), её позицию нельзя изменить"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該策略組不在配置檔案中（執行時加入），位置無法調整"
          }
        }
      }
    },
    "无法安全地重排策略组（配置使用了 YAML 锚点或特殊格式）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reorder the groups safely (the profile uses YAML anchors or an unusual layout)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポリシーグループを安全に並べ替えられません（プロファイルが YAML アンカーまたは特殊な形式を使用しています）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정책 그룹을 안전하게 재정렬할 수 없습니다(프로파일에 YAML 앵커나 특수 형식이 사용됨)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно изменить порядок групп (в профиле используются YAML-якоря или нестандартный формат)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全地重排策略組（配置使用了 YAML 錨點或特殊格式）"
          }
        }
      }
    },
    "配置文件中没有可排序的策略组": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile file has no policy groups to reorder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルに並べ替えできるポリシーグループがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로파일에 정렬할 정책 그룹이 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле профиля нет групп для сортировки"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置檔案中沒有可排序的策略組"
          }
        }
      }
    },
    "编辑排序": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Order"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えを編集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순서 편집"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить порядок"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯排序"
          }
        }
      }
    },
    "%@ (自定义)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Custom)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（カスタム）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (사용자 지정)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (своя)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (自訂)"
          }
        }
      }
    },
    "拖动或置顶来调整顺序。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag groups or move them to the top to change the order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグまたは「先頭へ移動」で順序を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하거나 맨 위로 이동해 순서를 바꿉니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите группы или переместите их в начало, чтобы изменить порядок."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動或置頂來調整順序。"
          }
        }
      }
    },
    "原配置不会被修改：首次保存时会自动复制出「%@」，新顺序写入副本并切换到它。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original profile is never changed: the first save automatically creates “%@”, writes the new order into that copy and switches to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のプロファイルは変更されません：最初の保存時に「%@」が自動で複製され、新しい順序はその複製に書き込まれ、複製に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 프로파일은 바뀌지 않습니다: 처음 저장할 때 '%@'이(가) 자동으로 복제되고, 새 순서는 복제본에 기록되며 복제본으로 전환됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный профиль не меняется: при первом сохранении автоматически создаётся «%@», новый порядок записывается в эту копию, и она становится текущей."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原配置不會被修改：首次儲存時會自動複製出「%@」，新順序寫入副本並切換到它。"
          }
        }
      }
    },
    "这是「%@」的副本，新顺序只写入这个副本（注释和其他内容不变，上一版备份为 .bak）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a copy of “%@”. The new order is written only into this copy (comments and everything else stay as they are; the previous version is kept as .bak)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは「%@」の複製です。新しい順序はこの複製にのみ書き込まれます（コメントやその他の内容は変わらず、前のバージョンは .bak として保存されます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'의 복제본입니다. 새 순서는 이 복제본에만 기록됩니다(주석과 다른 내용은 그대로이며 이전 버전은 .bak으로 보관됩니다)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это копия «%@». Новый порядок записывается только в эту копию (комментарии и остальное не меняются, предыдущая версия сохраняется как .bak)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是「%@」的副本，新順序只寫入這個副本（註釋和其他內容不變，上一版備份為 .bak）。"
          }
        }
      }
    },
    "订阅更新时，副本会用订阅的新内容重新生成，并保持此顺序；新增的策略组保留订阅中的位置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the subscription updates, this copy is rebuilt from the new subscription content and keeps this order; new groups keep their place from the subscription."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読が更新されると、この複製は新しい内容から再生成され、この順序が維持されます。新しいグループは購読内の位置のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 업데이트되면 이 복제본은 구독의 새 내용으로 다시 만들어지고 이 순서가 유지됩니다. 새 그룹은 구독에서의 위치를 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При обновлении подписки копия создаётся заново из нового содержимого и сохраняет этот порядок; новые группы остаются на своих местах из подписки."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱更新時，副本會用訂閱的新內容重新生成，並保持此順序；新增的策略組保留訂閱中的位置。"
          }
        }
      }
    },
    "副本立即恢复为订阅自带的顺序，之后的订阅更新也不再重新排列。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy returns to the subscription's own order now, and later updates no longer reorder it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複製はすぐに購読本来の順序に戻り、以後の更新でも並べ替えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복제본이 즉시 구독 원래의 순서로 돌아가며, 이후 업데이트에서도 다시 정렬되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия сразу вернётся к исходному порядку подписки, и последующие обновления больше не будут его менять."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本立即恢復為訂閱自帶的順序，之後的訂閱更新也不再重新排列。"
          }
        }
      }
    },
    "当前为副本，复制自「%@」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a copy of “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の複製を使用中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'의 복제본 사용 중"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется копия «%@»"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前為副本，複製自「%@」"
          }
        }
      }
    },
    "复制自「%@」· 随订阅更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy of “%@” · updates with the subscription"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の複製 · 購読と一緒に更新"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'의 복제본 · 구독과 함께 업데이트"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия «%@» · обновляется вместе с подпиской"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製自「%@」· 隨訂閱更新"
          }
        }
      }
    },
    "复制自「%@」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy of “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の複製"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'의 복제본"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия «%@»"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製自「%@」"
          }
        }
      }
    },
    "这个系统版本无法限制脚本运行时间，为避免脚本卡死已停止运行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iOS version cannot limit how long a script runs, so scripts are not run (a stuck script could not be stopped)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iOS ではスクリプトの実行時間を制限できないため、停止できなくなるのを防ぐために実行しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iOS 버전에서는 스크립트 실행 시간을 제한할 수 없어, 멈춘 스크립트를 막기 위해 실행하지 않습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия iOS не умеет ограничивать время работы скрипта, поэтому скрипты не запускаются (зависший скрипт нельзя было бы остановить)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個系統版本無法限制腳本執行時間，為避免腳本卡死已停止執行"
          }
        }
      }
    },
    "「%@」副本已手动修改，没有随订阅更新。可在配置列表中选择「从订阅重新生成」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was edited by hand and did not follow the subscription update. Choose “Regenerate from Subscription” in the profile list to replace it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は手動で編集されているため、購読の更新に追従しませんでした。プロファイル一覧の「購読から再生成」で置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) 직접 수정되어 구독 업데이트를 따르지 않았습니다. 프로파일 목록에서 '구독에서 다시 생성'으로 바꿀 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» изменён вручную и не обновлён вместе с подпиской. Чтобы заменить его, выберите «Пересоздать из подписки» в списке профилей."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」副本已手動修改，沒有隨訂閱更新。可在配置列表中選擇「從訂閱重新生成」。"
          }
        }
      }
    },
    "「%@」无法保持策略组顺序，已恢复为订阅的顺序：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” could not keep its group order and now uses the subscription’s order: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」はグループの順序を保てなかったため、購読の順序に戻しました：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@'의 그룹 순서를 유지할 수 없어 구독의 순서로 되돌렸습니다: %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: порядок групп сохранить не удалось, используется порядок подписки: %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法保持策略組順序，已恢復為訂閱的順序：%@"
          }
        }
      }
    },
    "重新生成「%@」前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before regenerating “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を再生成する前"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 다시 생성 전"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед пересозданием «%@»"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新生成「%@」前"
          }
        }
      }
    },
    "从订阅重新生成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerate from Subscription"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読から再生成"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독에서 다시 생성"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересоздать из подписки"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從訂閱重新生成"
          }
        }
      }
    },
    "删除「%@」？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'을(를) 삭제할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%@»?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除「%@」？"
          }
        }
      }
    },
    "这些副本是从它复制的：%@。删除后它们会保留为本地配置，不再随订阅更新。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These copies were made from it: %@. They stay as local profiles and no longer follow the subscription."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の複製はこのプロファイルから作られています：%@。削除後はローカルプロファイルとして残り、購読には追従しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 복제본이 이 프로파일에서 만들어졌습니다: %@. 삭제하면 로컬 프로파일로 남고 더 이상 구독을 따르지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из него сделаны копии: %@. Они останутся локальными профилями и перестанут обновляться вместе с подпиской."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些副本是從它複製的：%@。刪除後它們會保留為本地配置，不再隨訂閱更新。"
          }
        }
      }
    },
    "副本已手动修改，未随订阅更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edited by hand · not updated with the subscription"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で編集済み · 購読と一緒に更新されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 수정됨 · 구독과 함께 업데이트되지 않음"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменено вручную · не обновляется с подпиской"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本已手動修改，未隨訂閱更新"
          }
        }
      }
    },
    "这是 http:// 地址，密码和备份会以明文传输。请改用 https://，或确认「允许不安全的 http 连接」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an http:// address: the password and the backup would travel in clear text. Use https://, or confirm “Allow Insecure http Connection”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// のアドレスです。パスワードとバックアップが平文で送信されます。https:// を使うか、「安全でない http 接続を許可」を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// 주소입니다. 비밀번호와 백업이 평문으로 전송됩니다. https://를 쓰거나 '안전하지 않은 http 연결 허용'을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это адрес http://: пароль и резервная копия будут переданы открытым текстом. Используйте https:// или подтвердите «Разрешить небезопасное http-подключение»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 http:// 地址，密碼和備份會以明文傳輸。請改用 https://，或確認「允許不安全的 http 連線」。"
          }
        }
      }
    },
    "包含 MitM 根证书私钥的备份必须加密": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup with the MitM root private key must be encrypted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MitM ルート証明書の秘密鍵を含むバックアップは暗号化が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MitM 루트 인증서 개인 키가 포함된 백업은 암호화해야 합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервную копию с закрытым ключом корневого сертификата MitM нужно шифровать"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含 MitM 根證書私鑰的備份必須加密"
          }
        }
      }
    },
    "允许不安全的 http 连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Insecure http Connection"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全でない http 接続を許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하지 않은 http 연결 허용"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить небезопасное http-подключение"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許不安全的 http 連線"
          }
        }
      }
    },
    "http:// 地址不加密传输：用户名、密码和备份内容在网络上可被看到。请尽量使用 https://。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// is not encrypted: the user name, password and backup can be seen on the network. Use https:// whenever you can."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// は暗号化されません。ユーザー名、パスワード、バックアップの内容がネットワーク上で見えてしまいます。できるだけ https:// を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "http://는 암호화되지 않습니다. 사용자 이름, 비밀번호, 백업 내용이 네트워크에서 보일 수 있습니다. 가능하면 https://를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// не шифруется: имя пользователя, пароль и содержимое резервной копии видны в сети. По возможности используйте https://."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// 地址不加密傳輸：使用者名稱、密碼和備份內容在網路上可被看到。請儘量使用 https://。"
          }
        }
      }
    },
    "包含根证书私钥时备份总是加密。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups that include the root private key are always encrypted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルート証明書の秘密鍵を含むバックアップは常に暗号化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 인증서 개인 키를 포함하면 백업은 항상 암호화됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии с закрытым ключом корневого сертификата всегда шифруются."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含根證書私鑰時備份總是加密。"
          }
        }
      }
    },
    "未加密：备份里有所有节点的密码和控制密钥，能读取服务器文件的人都能看到。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not encrypted: the backup holds every node password and the controller secret; anyone who can read the files on the server can see them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化なし：バックアップにはすべてのノードのパスワードとコントローラーの秘密鍵が含まれ、サーバー上のファイルを読める人は誰でも見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화 안 함: 백업에는 모든 노드 비밀번호와 컨트롤러 키가 들어 있어 서버의 파일을 읽을 수 있는 사람은 누구나 볼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без шифрования: в копии все пароли узлов и секрет контроллера; их увидит любой, кто может читать файлы на сервере."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未加密：備份裡有所有節點的密碼和控制金鑰，能讀取伺服器檔案的人都能看到。"
          }
        }
      }
    },
    "允许不安全的 http 连接？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow an insecure http connection?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全でない http 接続を許可しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하지 않은 http 연결을 허용할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить небезопасное http-подключение?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許不安全的 http 連線？"
          }
        }
      }
    },
    "仍然允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Anyway"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それでも許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래도 허용"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё равно разрешить"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然允許"
          }
        }
      }
    },
    "用户名、密码和备份会以明文经过网络，同一网络中的其他人可以看到。建议只在自己的局域网内这样使用，并开启加密备份。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user name, password and backup cross the network in clear text, and others on the same network can see them. Only use this on your own LAN, with encrypted backups turned on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名、パスワード、バックアップが平文でネットワークを通り、同じネットワークの他の人が見られます。自分の LAN 内だけで、暗号化バックアップをオンにして使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름, 비밀번호, 백업이 평문으로 네트워크를 지나며 같은 네트워크의 다른 사람이 볼 수 있습니다. 자신의 LAN에서만, 암호화 백업을 켠 채로 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя, пароль и копия идут по сети открытым текстом, и их видят другие в той же сети. Используйте это только в своей локальной сети и включите шифрование копий."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者名稱、密碼和備份會以明文經過網路，同一網路中的其他人可以看到。建議只在自己的區域網內這樣使用，並開啟加密備份。"
          }
        }
      }
    },
    "配置文件不是 YAML 映射": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile is not a YAML mapping"
