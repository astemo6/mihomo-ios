        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request body is binary or larger than 32 KB and wasn't fully recorded, so it can't be replayed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求體是二進位制或超過 32 KB，沒有完整記錄，無法重放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストボディがバイナリか 32 KB を超えており、完全には記録されていないため再送できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 본문이 바이너리이거나 32 KB를 넘어 전부 기록되지 않았으므로 다시 보낼 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тело запроса двоичное или больше 32 КБ и записано не полностью, поэтому повторить его нельзя."
          }
        }
      }
    },
