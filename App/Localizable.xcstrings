    "已保存。端口 / 密钥 / IPv6 / MTU / 内存上限在断开后重新连接时生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Port / secret / IPv6 / MTU / memory limit apply after you disconnect and reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存。埠 / 金鑰 / IPv6 / MTU / 記憶體上限在斷開後重新連線時生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。ポート / シークレット / IPv6 / MTU / メモリ上限は切断して再接続した後に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했습니다. 포트 / 시크릿 / IPv6 / MTU / 메모리 한도는 연결을 끊고 다시 연결한 후 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Порт / секрет / IPv6 / MTU / предел памяти применятся после переподключения."
          }
        }
      },
      "extractionState": "manual"
    },
    "已保存。连接方式、路由和隧道范围在重新连接后生效。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存。連線方式、路由和隧道範圍在重新連線後生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Mode, routes and tunnel scope apply after reconnecting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。接続方式、ルート、トンネル範囲は再接続後に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했습니다. 연결 방식, 경로, 터널 범위는 다시 연결한 뒤 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Режим, маршруты и охват туннеля вступят в силу после переподключения."
          }
        }
      }
    },
