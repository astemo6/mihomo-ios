    "该配置已停用，启用后才能设为当前配置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile is disabled. Enable it to make it the current profile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルは無効です。有効にすると現在のプロファイルにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로파일은 비활성화되어 있습니다. 활성화해야 현재 프로파일로 설정할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот профиль отключён. Включите его, чтобы сделать текущим."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該配置已停用，啟用後才能設為當前配置"
          }
        }
      }
    },
    "当前配置不能停用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current profile can't be disabled"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプロファイルは無効にできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 프로파일은 비활성화할 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий профиль нельзя отключить"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前配置不能停用"
          }
        }
      }
    },
    "右滑更新；左滑删除或停用；长按查看更多操作。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right to update; swipe left to delete or disable; touch and hold for more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右スワイプで更新、左スワイプで削除または無効化、長押しでその他の操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽으로 밀어 업데이트, 왼쪽으로 밀어 삭제 또는 비활성화, 길게 눌러 더 많은 작업."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вправо, чтобы обновить; влево — удалить или отключить; удерживайте для других действий."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右滑更新；左滑刪除或停用；長按檢視更多操作。"
          }
        }
      }
    },
    "点右上角 + 添加配置订阅或节点订阅。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to add a profile subscription or a node subscription."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の + でプロファイル購読またはノード購読を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 +를 눌러 프로파일 구독 또는 노드 구독을 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите + вверху справа, чтобы добавить подписку на профиль или на узлы."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點右上角 + 新增配置訂閱或節點訂閱。"
          }
        }
      }
    },
    "启用订阅后，节点会加入配置。": {
      "localizations": {
