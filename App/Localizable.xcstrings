    "关闭 UDP 后，这条链只转发 TCP。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 UDP 後，這條鏈只轉發 TCP。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With UDP off, this chain only forwards TCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP をオフにすると、このチェーンは TCP だけを転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP를 끄면 이 체인은 TCP만 전달합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если UDP выключен, цепочка передаёт только TCP."
          }
        }
      }
    },
    "添加节点或策略组": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加節點或策略組"
          }
        },
        "en": {
