            "value": "프록시 체인 「%@」을(를) 삭제할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить цепочку прокси «%@»?"
          }
        }
      }
    },
    "引用它的策略组和规则会一并移除这条链。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引用它的策略組和規則會一併移除這條鏈。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Policy groups and rules that use it will drop this chain too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを使うポリシーグループとルールからも、このチェーンが外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 체인을 쓰는 정책 그룹과 규칙에서도 함께 제거됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группы политик и правила, которые её используют, тоже перестанут её использовать."
          }
        }
      }
    },
    "还没有成员": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
