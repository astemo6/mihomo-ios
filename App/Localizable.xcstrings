          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルール → グローバル → 直接 を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙 → 전역 → 직접 순으로 전환합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
