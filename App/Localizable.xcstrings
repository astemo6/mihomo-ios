    "VPN 配置已停用：在 设置 → VPN 中选中 Mihomo，或重新连接。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 配置已停用：在 設定 → VPN 中選中 Mihomo，或重新連線。"
          }
        },
        "en": {
