    "#%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#%lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "#%lld"
