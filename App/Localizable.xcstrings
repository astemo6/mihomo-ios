          }
        }
      }
    },
    "还没有代理链": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有代理鏈"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No proxy chains yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシチェーンはまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 프록시 체인이 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цепочек прокси пока нет"
          }
        }
      }
    },
    "点右上角 + 添加。代理链让流量依次经过多个节点或策略组。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點右上角 + 添加。代理鏈讓流量依次經過多個節點或策略組。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to add one. A proxy chain sends traffic through several nodes or policy groups in turn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の + で追加します。プロキシチェーンは通信を複数のノードやポリシーグループに順番に通します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 + 를 눌러 추가하세요. 프록시 체인은 트래픽이 여러 노드나 정책 그룹을 차례로 거치게 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите + вверху справа, чтобы добавить. Цепочка прокси пропускает трафик через несколько узлов или групп политик по очереди."
          }
        }
      }
    },
    "启用的代理链会作为策略出现在策略组和规则里。成员在当前配置里找不到时，这条链不生效。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用的代理鏈會作為策略出現在策略組和規則裡。成員在目前配置裡找不到時，這條鏈不生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled chains appear as policies in policy groups and rules. A chain whose members are not in the current profile does not take effect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なチェーンはポリシーとしてポリシーグループとルールに表示されます。メンバーが現在のプロファイルにない場合、そのチェーンは使われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 체인은 정책 그룹과 규칙에서 정책으로 나타납니다. 구성원이 현재 프로파일에 없으면 그 체인은 적용되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включённые цепочки появляются как политики в группах политик и правилах. Если участников нет в текущем профиле, цепочка не действует."
          }
        }
      }
    },
    "代理链": {
