    "添加用户": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add User"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーを追加"
          }
        },
        "ko": {
