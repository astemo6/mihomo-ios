    "加密备份": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypt Backups"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを暗号化"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 암호화"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шифровать копии"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密備份"
          }
        }
      }
    },
    "加密密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption password"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化パスワード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화 비밀번호"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль шифрования"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密密碼"
          }
        }
      }
    },
    "备份先用 AES-256-GCM 加密（密钥由加密密码经 PBKDF2 生成）再上传；恢复时需要同一个密码，忘记就无法恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are encrypted with AES-256-GCM (key derived from the encryption password with PBKDF2) before upload. Restoring needs the same password; if you forget it, the backup cannot be restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは AES-256-GCM で暗号化してからアップロードします（鍵は暗号化パスワードから PBKDF2 で生成）。復元には同じパスワードが必要で、忘れると復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업은 AES-256-GCM으로 암호화한 뒤 업로드합니다(키는 암호화 비밀번호에서 PBKDF2로 생성). 복원하려면 같은 비밀번호가 필요하며, 잊으면 복원할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед загрузкой копия шифруется AES-256-GCM (ключ выводится из пароля через PBKDF2). Для восстановления нужен тот же пароль; без него восстановить нельзя."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份先用 AES-256-GCM 加密（金鑰由加密密碼經 PBKDF2 生成）再上傳；恢復時需要同一個密碼，忘記就無法恢復。"
          }
        }
      }
    },
    "每次备份上传一个新文件，超过保留数量时删除最旧的。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each backup uploads a new file; beyond the kept number the oldest are deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップのたびに新しいファイルをアップロードし、保持数を超えると古いものから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업할 때마다 새 파일을 올리고, 보관 개수를 넘으면 가장 오래된 것부터 지웁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая копия загружается новым файлом; сверх заданного числа самые старые удаляются."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次備份上傳一個新檔案，超過保留數量時刪除最舊的。"
          }
        }
      }
    },
    "立即备份": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Up Now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐバックアップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 백업"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать копию"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即備份"
          }
        }
      }
    },
    "请先填写加密密码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the encryption password first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に暗号化パスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 암호화 비밀번호를 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала укажите пароль шифрования."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
