        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コアにノード「%@」が見つかりません。プロファイルが変わった可能性があります。再読み込みしてからやり直してください"
          }
        },
        "ko": {
          "stringUnit": {
