{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "\n规则集 / 节点集：%lld 个已下载，%lld 个失败（可在「更多 → 高级设置 → 规则集与节点集」中重试）": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n規則集 / 節點集：%lld 個已下載，%lld 個失敗（可在「更多 → 高階設定 → 規則集與節點集」中重試）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nRule sets / node providers: %lld downloaded, %lld failed (retry in More → Advanced Settings → Rule Sets & Node Sets)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\nルールセット / ノードセット：%lld 件ダウンロード、%lld 件失敗（「その他 → 詳細設定 → ルールセットとノードセット」で再試行）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n규칙 세트 / 노드 세트: %lld개 다운로드, %lld개 실패 (「더 보기 → 고급 설정 → 규칙 세트 및 노드 세트」에서 다시 시도)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nНаборы правил / узлов: загружено %lld, ошибок %lld (повторите в «Ещё → Расширенные настройки → Наборы правил и узлов»)"
          }
        }
      }
    },
